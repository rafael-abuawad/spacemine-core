    reserve_remaining: uint256
    emission_rate: uint256
    total_weight: uint256
    reward_per_weight_stored: uint256
    last_update: uint64
    active: bool


# @dev A staked SCV position. The field order is part of the ABI.
struct Position:
    node_id: uint256
    owner: address
    weight: uint256
    reward_per_weight_paid: uint256
    accrued: uint256


